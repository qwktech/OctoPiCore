variant: fcos
version: 1.6.0
passwd:
  users:
    - name: core
      ssh_authorized_keys_local:
        - keys/octopicore-key.pub
    - name: t0-user
storage:
  directories:
    - path: /home/t0-user/.config
      mode: 0755
      user:
        name: t0-user
      group:
        name: t0-user
    - path: /home/t0-user/.config/containers
      mode: 0755
      user:
        name: t0-user
      group:
        name: t0-user
    - path: /home/t0-user/.config/containers/systemd
      mode: 0755
      user:
        name: t0-user
      group:
        name: t0-user
  files:
    - path: /var/lib/systemd/linger/t0-user
      mode: 0644
    - path: /home/t0-user/.config/containers/systemd/octoprint.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlet/octoprint.container
      user:
        name: t0-user
      group:
        name: t0-user
    - path: /home/t0-user/.config/containers/systemd/octoprint.volume
      mode: 0644
      overwrite: true
      contents:
        local: quadlet/octoprint.volume
      user:
        name: t0-user
      group:
        name: t0-user
