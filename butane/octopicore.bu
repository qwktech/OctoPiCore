variant: fcos
version: 1.6.0
passwd:
  users:
    - name: core
      ssh_authorized_keys_local:
        - keys/octopicore-key.pub
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
         octoprint.local
    - path: /etc/containers/systemd/octoprint.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlet/octoprint.container
    - path: /etc/containers/systemd/octoprint.volume
      mode: 0644
      overwrite: true
      contents:
        local: quadlet/octoprint.volume
